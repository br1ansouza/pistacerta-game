{
  "name": "pistacerta-game",
  "version": "2.8.3",
  "private": true,
  "type": "module",
  "description": "Jogo de adivinhação de automóveis com pistas progressivas.",
  "repository": {
    "type": "git",
    "url": "https://github.com/br1ansouza/pistacerta-game.git"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --hot scripts/dev-api.ts",
    "dev:web": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "validate:content": "bun run scripts/validate-content.ts",
    "fipe": "bun run scripts/fipe-lookup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "refresh:fipe": "bun run scripts/refresh-fipe.ts",
    "import:fipe": "bun run scripts/import-fipe.ts",
    "build:worker-content": "bun run scripts/build-worker-content.ts",
    "deploy": "bun run build:worker-content && bun run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@untitledui/icons": "^0.0.22",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.11",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.121.0"
  }
}
